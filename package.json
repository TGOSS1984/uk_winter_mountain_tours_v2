  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@jest/globals": "^30.1.2",
    "babel-jest": "^30.1.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.3",
